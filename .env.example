# Use the existing LLM_API_KEY or configure GPT_API_KEY. Never commit real keys.
GPT_API_KEY=
GPT_MODEL=gpt-6.1-sol
GPT_BASE_URL=https://4router.net/v1
GPT_PORT=8788
# Absolute path to the directory containing P1-产品参数库.
LOCAL_KB_PATH=

# Optional persistent research database directory. Default: .cache/gpt/research
RESEARCH_DATA_DIR=
# Optional dedicated search providers; use one, otherwise try model web_search.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Browser capture (default on-demand); anonymous browser, no user profile.
RESEARCH_BROWSER_ENABLED=1
RESEARCH_BROWSER_EXECUTABLE=
# Optional explicit Playwright module entry when using a bundled runtime.
RESEARCH_PLAYWRIGHT_MODULE=
